# Copy this file to .env.local (or .env) and fill in real values.
# .env* is gitignored — never commit real keys.

# --- Supabase (required for live submissions, the admin queue, and flagging) ---
# Project Settings -> API in your Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Cloudflare Turnstile (optional but recommended before going public) ---
# Site key is public and safe to ship in the client bundle.
# dash.cloudflare.com -> Turnstile -> Add site. Leave unset to launch without
# it; the submit form still works via honeypot + rate limiting alone.
VITE_TURNSTILE_SITE_KEY=

# --- Admin UI copy only, not a security boundary (see SETUP.md) ---
VITE_ADMIN_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# The following are NOT read by the Vite app — they're Supabase Edge Function
# secrets. Set them with the Supabase CLI, not in this file:
#
#   supabase secrets set TURNSTILE_SECRET_KEY=...
#   supabase secrets set IP_HASH_SALT=$(openssl rand -hex 32)
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# the Supabase platform for every deployed function — you never set those
# yourself. Full steps are in SETUP.md.
# ---------------------------------------------------------------------------
